{
  "name": "station_database",
  "version": "0.0.1",
  "description": "JSON・CSVデータの処理・テストに利用するスクリプト",
  "private": "true",
  "main": "not-exist.js",
  "scripts": {
    "check": "tsx src/ts/check.ts",
    "prebuild-diagram": "tsx src/ts/diagram.ts",
    "build": "tsx src/ts/build.ts && tsx src/ts/build.ts -e",
    "bump-version-main": "tsx src/ts/bump_version.ts",
    "bump-version-extra": "tsx src/ts/bump_version.ts -e",
    "schema": "rm -f out/*/schema/*.json && tsx src/ts/jsonschema && tsx src/ts/jsonschema -e",
    "docs": "rm -f docs/*.md && jsonschema2md -d out/main/schema -o docs/ -x - -i src/schema_locale -h false -n",
    "test-format-main": "DATASET=main jest -- src/ts/format.test.ts",
    "test-format-extra": "DATASET=extra jest -- src/ts/format.test.ts",
    "test-subset": "jest -- src/ts/subset.test.ts",
    "test-version": "jest -- src/ts/version.test.ts",
    "test-update-main": "DATASET=main jest -- src/ts/update.test.ts",
    "test-update-extra": "DATASET=extra jest -- src/ts/update.test.ts",
    "check-update": "tsx src/ts/check_update.ts",
    "download": "tsx src/ekimemo/download.ts",
    "test-ekimemo": "jest --  src/ekimemo/check.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seo-4d696b75/station_database.git"
  },
  "keywords": [
    "json",
    "csv"
  ],
  "author": "Seo-4d696b75",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Seo-4d696b75/station_database/issues"
  },
  "homepage": "https://github.com/Seo-4d696b75/station_database#readme",
  "devDependencies": {
    "@adobe/jsonschema2md": "^8.0.11",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/yargs": "^17.0.35",
    "ajv": "8.11.0",
    "axios": "^1.18.1",
    "csv-parse": "^7.0.2",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "octokit": "^3.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "yargs": "^18.1.0"
  }
}
